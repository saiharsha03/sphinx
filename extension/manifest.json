{
  "manifest_version": 3,
  "name": "Sphinx",
  "version": "1.2.2",
  "description": "2FA codes from your phone, typed into the field; and links, text and small files between the phone and this laptop.",
  "minimum_chrome_version": "146",
  "incognito": "not_allowed",
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "contextMenus",
    "activeTab",
    "downloads",
    "notifications"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Sphinx",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' https:; frame-ancestors 'none'"
  }
}
